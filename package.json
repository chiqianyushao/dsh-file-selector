{
  "name": "dsh-file-selector",
  "version": "0.2.1",
  "description": "Adds the missing selection half to the harness's built-in file browser and document preview: put a file path, or a selected line range, into the composer draft.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "web-ui",
    "file-reference"
  ],
  "author": "chiqianyushao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiqianyushao/dsh-file-selector.git"
  },
  "homepage": "https://github.com/chiqianyushao/dsh-file-selector#readme",
  "bugs": {
    "url": "https://github.com/chiqianyushao/dsh-file-selector/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node scripts/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
